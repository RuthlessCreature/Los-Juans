{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juan-autonomous-agent",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "JUAN_CORE", "class_name": "JuanCore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JuanCore"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
